    {
      "parameters": {
        "jsCode": "let text = $json.output || $json.text || $json.message || \"\";\n\n// convert escaped newlines into real text\ntext = text.replace(/\\\\n/g, \"\\n\");\n\n// remove markdown wrappers\ntext = text\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\ntry {\n  const parsed = JSON.parse(text);\n\n  return [\n    {\n      json: parsed\n    }\n  ];\n} catch (err) {\n  // Safe qualification defaults matching the clean scoring prompt\n  return [\n    {\n      json: {\n        score: 0,\n        keep: false,\n        reason: \"Parse failed\",\n        raw: text\n      }\n    }\n  ];\n}"
      },

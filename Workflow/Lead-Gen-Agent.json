    {
      "parameters": {
        "jsCode": "// 1. Fetch input items from n8n context\nconst items = $input.all();\nconst seen = new Set();\nconst results = [];\n\n// 2. Process and deduplicate elements\nfor (const item of items) {\n  const elements = item.json.elements || [];\n  \n  for (const el of elements) {\n    // Deduplicate by OSM id\n    if (seen.has(el.id)) continue;\n    seen.add(el.id);\n\n    results.push({\n      json: {\n        osm_id:    el.id,\n        name:      el.tags?.name || '',\n        website:   el.tags?.website || el.tags?.['contact:website'] || '',\n        phone:     el.tags?.phone || el.tags?.['contact:phone'] || '',\n        email:     el.tags?.email || el.tags?.['contact:email'] || '',\n        address:   [\n                     el.tags?.['addr:housenumber'],\n                     el.tags?.['addr:street'],\n                     el.tags?.['addr:city'],\n                     el.tags?.['addr:state'],\n                     el.tags?.['addr:postcode']\n                   ].filter(Boolean).join(', '),\n        type:      el.tags?.office || el.tags?.shop || el.tags?.amenity || el.tags?.craft || el.tags?.leisure || '',\n        lat:       el.lat || el.center?.lat || '',\n        lon:       el.lon || el.center?.lon || '',\n      }\n    });\n  }\n}\n\n// 3. Fisher-Yates Shuffle Algorithm to randomly mix the combined results\nfor (let i = results.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [results[i], results[j]] = [results[j], results[i]];\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

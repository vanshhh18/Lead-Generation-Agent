    {
      "parameters": {
        "jsCode": "// 1. Pull the fully rendered HTML source text from ScraperAPI's payload structure\nconst html = $json.data || $json.body || \"\";\n\n// 2. Extract Emails\nconst emails = html.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g) || [];\n\n// 3. Clean, validate, and filter out fake asset/image emails\nconst imageExtensions = ['.png', '.jpg', '.jpeg', '.gif', '.svg', '.webp', '.pdf'];\nconst cleanEmails = emails\n  .map(e => e.toLowerCase().trim())\n  .filter(e => !imageExtensions.some(ext => e.endsWith(ext))); // Drops files disguised as emails\n\n// Prioritize the best generic inbox prefixes if multiple exist\nconst validEmail =\n  cleanEmails.find(e => e.startsWith(\"info@\")) ||\n  cleanEmails.find(e => e.startsWith(\"contact@\")) ||\n  cleanEmails.find(e => e.startsWith(\"hello@\")) ||\n  cleanEmails[0] || \n  \"\";\n\n// 4. Extract Phone Numbers\nconst telLinkRegex = /href=\"tel:\\+?([\\d-]{7,15})\"/g;\nconst standardPhoneRegex = /(?:\\+?\\d{1,3}[\\s.-]?)?\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}/g;\n\nlet foundPhones = [];\nlet match;\n\n// Pass 1: Pull from HTML anchor links (href=\"tel:...\")\nwhile ((match = telLinkRegex.exec(html)) !== null) {\n    if (match[1]) foundPhones.push(match[1]);\n}\n\n// Pass 2: Pull standard formatting directly out of page text\nconst textMatches = html.match(standardPhoneRegex) || [];\nfoundPhones = foundPhones.concat(textMatches);\n\n// Clean up formatting artifacts, spaces, and short junk system numbers\nlet cleanPhones = foundPhones\n  .map(p => p.replace(/[^\\d+]/g, \"\")) // Strips characters, keeping only digits and +\n  .filter(p => p.length >= 10); // Ensures it's a real telephone string length\n\n// Reformat target output phone into a standardized string (e.g. +17322288383)\nlet validPhone = cleanPhones[0] || \"\";\nif (validPhone && !validPhone.startsWith(\"+\")) {\n    validPhone = validPhone.length === 10 ? \"+1\" + validPhone : \"+\" + validPhone;\n}\n\n// 5. Output clean data object properties straight to downstream nodes\nreturn {\n  email: validEmail,\n  phone: validPhone\n};"
      },
